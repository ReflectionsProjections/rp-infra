aws_region         = "us-east-1"
hermes_domain_name = "api.hermes.example.com"
hermes_codedeploy_artifact_bucket = "rp-hermes-codedeploy-artifacts"
hermes_letsencrypt_email = "infra@example.com"
rp_api_domain_name = "api-staging.reflectionsprojections.org"
rp_api_codedeploy_artifact_bucket = "rp-api-codedeploy-artifacts"
rp_api_letsencrypt_email = "infra@example.com"

# S3 bucket Terraform creates for manual Supabase backups.
rp_api_supabase_backup_bucket = "rp-api-supabase-backups"

# Optional if you want SSH in addition to SSM Session Manager.
# key_name = "your-ec2-keypair"
# ssh_cidr_blocks = ["YOUR.IP.ADDRESS.HERE/32"]
